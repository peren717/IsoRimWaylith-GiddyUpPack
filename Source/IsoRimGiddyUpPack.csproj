<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pack's visual part (RimWorld 1.7 Waylith: net10 + Harmony, against the game-root Assembly-CSharp).
       IsoRim.dll is IsoRim Waylith's (public Api only); override with -p:IsoRimDll=<path> to build against a worktree.
       Giddy-Up is reached by name at run time (no reference), so a Giddy-Up update cannot stop the pack loading. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimWaylith_GiddyUpPack</AssemblyName>
    <RootNamespace>IsoRimGiddyUpPack</RootNamespace>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <IsoRimDll Condition="'$(IsoRimDll)' == ''">..\..\IsoRim17\1.7\Assemblies\IsoRim.dll</IsoRimDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>..\..\..\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>..\..\..\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>..\..\..\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRim"><HintPath>$(IsoRimDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
