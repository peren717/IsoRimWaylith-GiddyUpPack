<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pack's IsoRim ProjectZ part, loaded only with ProjectZ active (LoadFolders.xml: 1.7/IsoRimZ). A separate DLL so the
       visual part never references ProjectZ (an assembly naming ProjectZ types fails to load without it).
       ProjectZ: public ProjectZ.Api only; override with -p:ProjectZDll=<path> to build against a worktree.
       Giddy-Up: its public MountUtility.FindPlaceToDismount (patched by name, fail-soft). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimWaylith_GiddyUpPackZ</AssemblyName>
    <RootNamespace>IsoRimGiddyUpPackZ</RootNamespace>
    <OutputPath>..\1.7\IsoRimZ\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <ProjectZDll Condition="'$(ProjectZDll)' == ''">..\..\IsoRimProjectZ\1.7\Assemblies\IsoRimProjectZ.dll</ProjectZDll>
    <GiddyUpDll Condition="'$(GiddyUpDll)' == ''">..\..\..\..\..\workshop\content\294100\3674332861\1.7\Assemblies\GiddyUpCore.dll</GiddyUpDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>..\..\..\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>..\..\..\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>..\..\..\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRimProjectZ"><HintPath>$(ProjectZDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="GiddyUpCore"><HintPath>$(GiddyUpDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
